# Copier ce fichier en .env (non versionné) : copy .env.example .env
# Aucun secret ici : l'API des taux de change n'en utilise pas.

# Port de l'hôte sur lequel le reverse proxy écoute
PROXY_PORT=8080

# Étiquette de l'image construite par compose (cairn-api:<TAG>)
TAG=dev

# Optionnel : autre source de taux que la BCE (tests, mock)
# ECB_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
